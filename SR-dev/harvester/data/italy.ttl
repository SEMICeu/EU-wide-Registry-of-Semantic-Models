  dct:requires <https://w3id.org/italia/onto/CLV/>, <https://w3id.org/italia/onto/TI/>,
    <https://w3id.org/italia/onto/l0/>, <https://w3id.org/italia/work-accident/onto/core/>;
  dct:title "INAIL Ontology about the PD DA1 document request"@en, "Ontologia INAIL relativa alla richiesta del documento PD DA1"@it;
  vann:preferredNamespaceUri "https://w3id.org/italia/work-accident/onto/proc6_pdda1/"^^xsd:anyURI;
  owl:versionInfo "Version 1.0 - Modified on 3 November 2023";
