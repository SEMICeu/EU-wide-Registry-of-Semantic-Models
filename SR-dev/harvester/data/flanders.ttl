<https://data.vlaanderen.be/ns/schuldbeheer> a adms:Asset, foaf:Document;
  dct:created "2025-05-15T00:00:00"^^xsd:dateTime;
  dct:creator <https://data.vlaanderen.be/id/organisatie/OVO002949>;
  dct:description "Het vocabularium \"Schuldbeheer\" heeft als doel om de informatie omtrent \"Eenheid van schuld\" te standaardiseren en een gemeenschappelijk begrip van essentiële informatie te ontwikkelen. Dit vocabularium is ontwikkeld binnen het GZG (Gemeente-zonder-gemeentehuis) Boost traject, samen met Lokaal Digitaal, specifiek voor het lokaal bestuur van Gent. Het beoogt een gemeenschappelijke taal en begrip te creëren over het begrip ‘eenheid van schuld’ tussen leveranciers en lokale besturen, die vaak verschillend communiceren."@nl;
  dct:identifier "https://data.vlaanderen.be/ns/schuldbeheer";
  dct:issued "2025-04-24T00:00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/NLD>;
  dct:modified "2025-05-15T00:00:00"^^xsd:dateTime;
  dct:title "Vocabularium Schuldbeheer"@nl;
  dct:type <http://purl.org/vocommons/voaf#Vocabulary>;
  vann:preferredNamespaceUri "https://data.vlaanderen.be/ns/"^^xsd:anyURI;
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://data.vlaanderen.be/id/organisatie/OVO002949>;
  dcat:distribution _:5e6c9eda986b26e, _:genid-b04a3c316b9c487c8f8809c4236962a115224-26A76974A9A33C81B3CE810AD077B946;
  foaf:homepage <https://data.vlaanderen.be/ns/schuldbeheer> .

