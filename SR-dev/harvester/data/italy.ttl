  rdfs:isDefinedBy <https://w3id.org/italia/data/distribution/le-JSON-LD>, <https://w3id.org/italia/data/distribution/le-RDF-TURTLE>,
    <https://w3id.org/italia/data/distribution/le-RDF-XML> .

<https://w3id.org/italia/onto/Learning> a adms:Asset;
  m8g:isReusedBy "https://w3id.org/italia/data/project/NDC"^^xsd:anyURI, "https://w3id.org/italia/data/project/OntoPiA"^^xsd:anyURI;
  dct:creator <https://w3id.org/italia/data/organization/support-unit/cnr-Z6HZEH/stlab>,
    <https://w3id.org/italia/data/public-organization/PCM-1RSIZZ>;
  dct:description "This is the ontology of the Italian application profile on higher education and AFAM. The ontology models information such as enrolment in AFAM - Alta Formazione Artistica, Musicale e Coreutica (Higher Education in Artistic, Musical and Choreographic Education) institutes, the degree obtained and its grade, and the educational offerings of these institutes. The modelling is used to define the API of the ANIS - Anagrafe Nazionale Istruzione Superiore (National Register of Higher Education) database."@en,
    "Questa è l'ontologia del profilo applicativo italiano sull'alta formazione e AFAM. L'ontologia modella informazioni come l'iscrizione a istituti AFAM - Alta Formazione Artistica, Musicale e Coreutica, il titolo di laurea ottenuto con la relativa votazione, l'offerta formativa di questi istituti. La modellazione è usata per definire le API della banca dati ANIS - Anagrafe Nazionale Istruzione Superiore"@it;
  dct:identifier "https://w3id.org/italia/onto/Learning";
  dct:issued "2023-07-27T00:00:00+00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/ENG>, <http://publications.europa.eu/resource/authority/language/ITA>;
  dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0>;
  dct:modified "2023-11-06T00:00:00+00:00"^^xsd:dateTime;
  dct:publisher <https://w3id.org/italia/data/public-organization/PCM-1RSIZZ>;
  dct:requires <https://w3id.org/italia/onto/COV>, <https://w3id.org/italia/onto/CPV>,
    <https://w3id.org/italia/onto/Language>, <https://w3id.org/italia/onto/RO>;
  dct:title "Learning Ontology"@en, "Ontologia della Formazione (inclusa Artistica, Musicale e Coreutica - AFAM)"@it;
  vann:preferredNamespaceUri "https://w3id.org/italia/onto/Learning/"^^xsd:anyURI;
  owl:versionInfo "Version 0.2 -  Introduction of some concepts such as Profession, QualificationLevel, credit. Better specification of the relations between learning and how this brings to the qualification.";
  adms:status <http://purl.org/adms/status/UnderDevelopment>;
  dcat:contactPoint <https://w3id.org/italia/data/contact-point/stat-off-mur>;
  dcat:distribution <https://w3id.org/italia/data/distribution/le-JSON-LD>, <https://w3id.org/italia/data/distribution/le-RDF-TURTLE>,
    <https://w3id.org/italia/data/distribution/le-RDF-XML>;
  dcat:keyword "voto"@it;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> .

