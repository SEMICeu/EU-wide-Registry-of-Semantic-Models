  dct:requires <https://w3id.org/italia/onto/IoT>, <https://w3id.org/italia/onto/l0>;
  dct:title "Weather Ontology of the LEO Project (Livestock Environment Open Data)"@en,
    "Ontologia dei dati meteo del progetto LEO (Livestock Environment Open Data) - ClimData"@it;
  vann:preferredNamespaceUri "https://w3id.org/leo/onto/weather/"^^xsd:anyURI;
  owl:versionInfo "Version 0.3 - June 2023 - Introduction of the installation concept for weather stations located within buildings of the livestock farm company site";
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://w3id.org/leo/data/contact-point/onto-aia>;
  dcat:distribution <https://w3id.org/leo/data/distribution/WT-JSON-LD>, <https://w3id.org/leo/data/distribution/WT-RDF-TURTLE>,
    <https://w3id.org/leo/data/distribution/WT-RDF-XML>;
  dcat:keyword "Ventosìtà"@it;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/ENVI> .

