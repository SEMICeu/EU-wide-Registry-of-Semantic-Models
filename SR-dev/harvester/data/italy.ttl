<https://w3id.org/italia/env/onto/rendis> a adms:Asset;
  m8g:isReusedBy "https://w3id.org/italia/env/ld/common/project/001-LD"^^xsd:anyURI,
    "https://w3id.org/italia/env/ld/common/project/WHOW"^^xsd:anyURI;
  dct:creator <https://w3id.org/italia/data/organization/support-unit/cnr-Z6HZEH/stlab>,
    <https://w3id.org/italia/env/ld/common/organisation/001>;
  dct:description "The RENDIS Module models concepts and properties to represent interventions aimed at soil restoration and protection and is modelled following the European eProcurement Ontology (https://github.com/isprambiente/dati-semantic/tree/main/assets/ontologies/rendis/latest)"@en,
    "Il Modulo RENDIS modella concetti e propriet&agrave; per rappresentare gli interventi volti al recupero e alla tutela del suolo ed &egrave; modellato seguendo le indicazioni dell&apos;ontologia del eProcurement Ontology a livello europeo (https://github.com/isprambiente/dati-semantic/tree/main/assets/ontologies/rendis/latest)"@it;
