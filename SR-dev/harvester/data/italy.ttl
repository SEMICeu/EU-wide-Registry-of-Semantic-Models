<https://w3id.org/italia/env/onto/place/Geometry> a rdfs:Class;
  rdfs:label "Geometry"@en, "Geometria"@it;
  rdfs:isDefinedBy <https://w3id.org/italia/env/ld/common/distribution/PLACE-JSON-LD>,
    <https://w3id.org/italia/env/ld/common/distribution/PLACE-RDF-TURTLE>, <https://w3id.org/italia/env/ld/common/distribution/PLACE-RDF-XML> .

<https://w3id.org/italia/env/onto/place> a adms:Asset;
  m8g:isReusedBy "https://w3id.org/italia/env/ld/common/project/001-LD"^^xsd:anyURI,
    "https://w3id.org/italia/env/ld/common/project/WHOW"^^xsd:anyURI;
  dct:creator <https://w3id.org/italia/data/organization/support-unit/cnr-Z6HZEH/stlab>,
    <https://w3id.org/italia/env/ld/common/organisation/001>;
  dct:description "The PLACE module extends the TOP module by adding classes and properties that describe in more detail locations and any georeferenced entities both physically and in their administrative sense. Consequently these classes are modelled as subclasses of Location (defined in the TOP module) through the use of the axiom rdfs:subClassOf. Similarly, the TOP module is extended by modelling a whole series of properties (e.g. hasAdministrativeUnit, hasCountry, etc.) as subproperties of the object property of the TOP module hasLocation through the use of the axiom rdfs:subPropertyOf. The module is aligned (https://github.com/isprambiente/dati-semantic/tree/main/assets/ontologies/place/latest) to GeoSPARQL and OntoPiA."@en,
    "Il modulo PLACE estende il modulo TOP aggiungendo classi e propriet&agrave; che descrivono in maniera pi&ugrave; dettagliata i luoghi ed ogni entit&agrave; georeferenziabile sia dal punto di vista fisico che nella loro accezione amministrativa. Di conseguenza tali classi sono modellate come sottoclassi di Location (definita nel modulo TOP) tramite l&apos;utilizzo dell&apos;assioma rdfs:subClassOf. In maniera analoga il modulo TOP &egrave; esteso modellando tutta una serie di propriet&agrave; (ex. hasAdministrativeUnit, hasCountry, ecc…) come sottopropriet&agrave; della object property del modulo TOP hasLocation tramite l&apos;utlizzo dell&apos;assioma rdfs:subPropertyOf. Il modulo &egrave; allineato (https://github.com/isprambiente/dati-semantic/tree/main/assets/ontologies/place/latest) a GeoSPARQL ed OntoPiA."@it;
  dct:identifier "https://w3id.org/italia/env/onto/place";
  dct:issued "2023-03-08T00:00:00+00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/ENG>, <http://publications.europa.eu/resource/authority/language/ITA>;
  dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0>;
  dct:modified "2025-06-26T00:00:00+00:00"^^xsd:dateTime;
  dct:publisher <https://w3id.org/italia/env/ld/common/organisation/001>;
  dct:requires <https://w3id.org/italia/env/onto/top/>;
  dct:title "Italian environmental application profile - PLACE Ontology"@en, "Profilo applicativo italiano ambientale - Ontologia PLACE"@it;
  vann:preferredNamespaceUri "https://w3id.org/italia/env/onto/place/"^^xsd:anyURI;
  owl:versionInfo "Version 0.4 - updated in March 2024 - Ontology metadata inserted - June 2025 - Authors inserted";
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://w3id.org/italia/env/ld/common/organization/001-LD>;
