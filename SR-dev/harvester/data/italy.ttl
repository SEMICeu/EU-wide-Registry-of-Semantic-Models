<https://w3id.org/leo/onto/animal> a adms:Asset;
  m8g:isReusedBy "https://w3id.org/leo/data/project/LEO"^^xsd:anyURI;
  dct:creator <https://w3id.org/leo/data/private-organization/00944701002>, <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:description "This is the ontology of farm animals developed in the context of the LEO project. In particular, it includes all the data representing the master data of farm animals. In the ontology, some properties are derived not only from the AIA (Italian Livestock Breeders' Association) systems but also from the BDN - National Database of Farm Animal Registry through application cooperation. Within the LEO project, the data represented within this ontology are called FieldData."@en,
    "Questa è l'ontologia degli animali di allevamento del progetto LEO. In particolare include tutti i dati che rappresentano l'anagrafica degli animali d'allevamento. Nell'ontologia alcune proprietà derivano non solo dai sistemi di AIA (Associazione Italiana Allevatori) ma anche, attraverso la cooperazione applicativa, dalla BDN - Banca Dati Nazionale dell'anagrafica degli animali d'allevamento. Nell'ambito del progetto LEO i dati rappresentati nell'ambito di questa ontologia sono detti FieldData."@it;
  dct:identifier "https://w3id.org/leo/onto/animal";
  dct:issued "2018-06-18T00:00:00+00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/ENG>, <http://publications.europa.eu/resource/authority/language/ITA>;
  dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0>;
  dct:modified "2023-06-20T00:00:00+00:00"^^xsd:dateTime;
  dct:publisher <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:requires <https://w3id.org/italia/onto/l0>;
  dct:title "Farm Animals Ontology"@en, "Ontologia degli animali di allevamento"@it;
  vann:preferredNamespaceUri "https://w3id.org/leo/onto/animal/"^^xsd:anyURI;
  owl:versionInfo "Version 1.2- June 2023 - Introduced the class Hybrid Genetic Type (used in the context of swines and rabbits)";
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://w3id.org/leo/data/contact-point/onto-aia>;
  dcat:distribution <https://w3id.org/leo/data/distribution/animal-JSON-LD>, <https://w3id.org/leo/data/distribution/animal-RDF-TURTLE>,
    <https://w3id.org/leo/data/distribution/animal-RDF-XML>;
  dcat:keyword "Bovine"@en;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/AGRI> .

