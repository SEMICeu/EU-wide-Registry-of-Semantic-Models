<https://w3id.org/leo/onto/analysis> a adms:Asset;
  m8g:isReusedBy "https://w3id.org/leo/data/project/LEO"^^xsd:anyURI;
  dct:creator <https://w3id.org/leo/data/private-organization/00944701002>, <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:description "This is the ontology used to model the data which in the LEO project are called LabData. In certain cases the ontology can be used for so called HealthData but when these are understood as observations of properties with certain values"@en,
    "Questa è l'ontologia usata per modellare i dati che nel progetto LEO sono chiamati LabData. In certi casi l'ontologia può essere usata per i dati cosiddetti HealthData ovvero dati sanitari ma quando questi sono intesi come osservazioni di proprietà con determinati valori"@it;
  dct:identifier "https://w3id.org/leo/onto/analysis";
  dct:issued "2019-03-14T00:00:00+00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/ENG>, <http://publications.europa.eu/resource/authority/language/ITA>;
  dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0>;
  dct:modified "2023-07-01T00:00:00+00:00"^^xsd:dateTime;
  dct:publisher <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:requires <https://w3id.org/italia/onto/MU>, <https://w3id.org/italia/onto/TI>,
    <https://w3id.org/italia/onto/l0>;
  dct:title "Analysis Ontology - LabData and HeathData"@en, "Ontologia delle Analisi di Laboratorio"@it;
  vann:preferredNamespaceUri "https://w3id.org/leo/onto/analysis/"^^xsd:anyURI;
  owl:versionInfo "Version 1.0 - 2023 - Revision of the subclasses of the SemenAnalysis with the introduction of the SpermAnalysis class useful to distinguish a generic sperm analysis to the DNA fragmanetation and Official Semen Control Analysis";
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://w3id.org/leo/data/contact-point/onto-aia>;
  dcat:distribution <https://w3id.org/leo/data/distribution/AN-JSON-LD>, <https://w3id.org/leo/data/distribution/AN-RDF-TURTLE>,
    <https://w3id.org/leo/data/distribution/AN-RDF-XML>;
  dcat:keyword "Analisi sperma"@it;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/AGRI>, <http://publications.europa.eu/resource/authority/data-theme/HEAL>,
    <http://publications.europa.eu/resource/authority/data-theme/TECH> .

