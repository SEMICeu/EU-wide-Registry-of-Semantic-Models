<https://implementatie.data.vlaanderen.be/ns/kwaliteit-wegen-en-wegmarkeringen> a
    adms:Asset, foaf:Document;
  dct:created "2023-07-24T00:00:00"^^xsd:dateTime;
  dct:creator <https://data.vlaanderen.be/id/organisatie/OVO002220>;
  dct:description """Het vocabularium van OSLO Kwaliteit Wegen en Wegmarkeringen is een verzameling van alle verschillende elementen die belangrijk zijn voor het beschrijven van wegen, wegmarkeringen, verharding en de gerelateerde aspecten rond de observatie van hun kwaliteit
De meeste termen werden gemapt op meerdere bestaande standaarden:OSLO Observaties en Metingen,OSLO Datakwaliteit,OSLO Openbaar DomeinenAWV OTL.
Daarnaast definieert dit vocabularium enkele eigen termen. Deze zijn te vinden onder Klassen en Eigenschappen."""@nl;
  dct:identifier "https://implementatie.data.vlaanderen.be/ns/kwaliteit-wegen-en-wegmarkeringen";
  dct:issued "2024-12-05T00:00:00"^^xsd:dateTime;
