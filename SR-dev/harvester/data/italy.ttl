    <https://w3id.org/leo/data/distribution/MEA-RDF-XML> .

<https://w3id.org/leo/onto/milking-efficiency-assessment/SingleMilkingDynamicAssessment>
  a rdfs:Class;
  rdfs:label "Single Milking Dynamic Assessment"@en, "Controllo Dinamico su Singola Mungitura Animale"@it;
  rdfs:isDefinedBy <https://w3id.org/leo/data/distribution/MEA-JSON-LD>, <https://w3id.org/leo/data/distribution/MEA-RDF-TURTLE>,
    <https://w3id.org/leo/data/distribution/MEA-RDF-XML> .

<https://w3id.org/leo/onto/milking-efficiency-assessment> a adms:Asset;
  m8g:isReusedBy "https://w3id.org/leo/data/project/LEO"^^xsd:anyURI;
  dct:creator <https://w3id.org/leo/data/private-organization/00944701002>, <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:description "This is the ontology used to model data on milking efficiency (including plant controls). The data is collected in the context of the LEO - Livestock Environment Open Data project. The data includes dynamic milking controls at the level of livestock farm statistics and at the level of individual animal milking parameters, which also vary according to the different devices used. In addition, the controls involve the milking plant's pulsantors setting parameters and vacuum fall tests"@en,
    "Questa è l'ontologia usata per modellare i dati relativi all'efficienza della mungitura (compresi i controlli sugli impianti). I dati sono raccolti nel contesto del progetto LEO - Livestock Environment Open Data. I dati comprendono i controlli dinamici sulla mungitura a livello di statistiche aziendali e a livello di singoli parametri individuali legati alla singola mungitura di animali, che variano anche a seconda dei diversi strumenti utilizzati. Inoltre, i controlli coinvolgono i parametri di settaggio dei pulsanti dell'impianto di mungitura e i test di caduta del vuoto."@it;
  dct:identifier "https://w3id.org/leo/onto/milking-efficiency-assessment";
  dct:issued "2023-03-10T00:00:00+00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/ENG>, <http://publications.europa.eu/resource/authority/language/ITA>;
  dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0>;
  dct:modified "2023-03-10T00:00:00+00:00"^^xsd:dateTime;
  dct:publisher <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:requires <https://w3id.org/leo/onto/livestock-assessment>;
  dct:title "Milking Efficiency Assessment Ontology - FieldData"@en, "Ontologia dei Controlli sull'Efficienza della Mungitura"@it;
  vann:preferredNamespaceUri "https://w3id.org/leo/onto/milking-efficiency-assessment/"^^xsd:anyURI;
  owl:versionInfo "Version 0.1 - 2023 - Creation of the ontology";
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://w3id.org/leo/data/contact-point/onto-aia>;
  dcat:distribution <https://w3id.org/leo/data/distribution/MEA-JSON-LD>, <https://w3id.org/leo/data/distribution/MEA-RDF-TURTLE>,
    <https://w3id.org/leo/data/distribution/MEA-RDF-XML>;
