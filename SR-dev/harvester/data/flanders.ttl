<https://data.vlaanderen.be/ns/slimme-stadsdistributie> a adms:Asset, foaf:Document;
  dct:created "2024-07-16T00:00:00"^^xsd:dateTime;
  dct:creator <https://data.vlaanderen.be/id/organisatie/OVO002949>;
  dct:description "Het vocabularium 'OSLO Slimme Stadsdistributie' definieert enkele eigen termen. Deze zijn te vinden onder Klassen en Eigenschappen, terwijl de gemapte termen opgelijst staan onder Externe Terminologie. De standaard richt zich op het interoperabel ontsluiten van data en bijbehorende contextuele informatie inzake stadsdistriutie. Het datamodel en het vocabularium werden opgesteld om op een eenduidige manier data te kunnen uitwisselen tussen steden en transportorganisaties."@nl;
  dct:identifier "https://data.vlaanderen.be/ns/slimme-stadsdistributie";
  dct:language <http://publications.europa.eu/resource/authority/language/NLD>;
  dct:modified "2024-07-16T00:00:00"^^xsd:dateTime;
  dct:title "Vocabularium OSLO Slimme Stadsdistributie"@nl;
  dct:type <http://purl.org/vocommons/voaf#Vocabulary>;
  vann:preferredNamespaceUri "https://data.vlaanderen.be/ns/"^^xsd:anyURI;
  dcat:contactPoint <https://data.vlaanderen.be/id/organisatie/OVO002949>;
  dcat:distribution _:5e6c9eda986b26d, _:genid-b04a3c316b9c487c8f8809c4236962a115226-42D37D4286DE60219400F6B6A8A3A3D7;
  foaf:homepage <https://data.vlaanderen.be/ns/slimme-stadsdistributie> .

