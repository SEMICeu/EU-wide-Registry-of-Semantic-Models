<https://data.vlaanderen.be/ns/lokale-economie> a adms:Asset, foaf:Document;
  dct:created "2024-01-17T00:00:00"^^xsd:dateTime;
  dct:creator <https://data.vlaanderen.be/id/organisatie/OVO002949>;
  dct:description "Het vocabularium OSLO-Lokale Economie definieert termen die van toepassing zijn om gegevens uit te wisselen over een lokale economie. Meerbepaald gaat het over bezoekersmetingen, transacties en alle factoren in de omgeving die een invloed kunnen hebben op de lokale economie. Het vocabularium geeft een overzicht van de gebruikte terminologie en daaraan gekoppelde definities."@nl;
  dct:identifier "https://data.vlaanderen.be/ns/lokale-economie";
  dct:issued "2024-12-05T00:00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/NLD>;
  dct:modified "2024-01-17T00:00:00"^^xsd:dateTime;
  dct:title "Vocabularium Lokale Economie"@nl;
  dct:type <http://purl.org/vocommons/voaf#Vocabulary>;
  vann:preferredNamespaceUri "https://data.vlaanderen.be/ns/"^^xsd:anyURI;
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://data.vlaanderen.be/id/organisatie/OVO002949>;
