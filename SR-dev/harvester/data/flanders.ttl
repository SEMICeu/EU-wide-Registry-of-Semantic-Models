<https://data.vlaanderen.be/doc/applicatieprofiel/terreindelen/> a adms:Asset, foaf:Document;
  dct:created "2018-11-27T00:00:00"^^xsd:dateTime;
  dct:creator <https://data.vlaanderen.be/id/organisatie/OVO002949>;
  dct:description "Het applicatieprofiel Terreindeel is een uitbreiding van het generieke object Deel. De objecten onder Terreindeel omvatten de functie of het doel van het Deel. Dit is naast het Fysiek Voorkomen (met uitbreidingen Begroeid Voorkomen en Onbegroeid Voorkomen) van een Deel, waar de fysieke eigenschappen van het aardoppervlak worden gegeven. De uitbreiding Terreindeel bevat niet de Delen die bestaan uit een wateroppervlak, deze zijn vervat onder de uitbreiding Waterdelen."@nl;
  dct:identifier "https://data.vlaanderen.be/doc/applicatieprofiel/terreindelen/";
  dct:issued "2018-11-27T00:00:00"^^xsd:dateTime;
