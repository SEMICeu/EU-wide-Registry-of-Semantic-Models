<https://data.vlaanderen.be/ns/nutsvoorzieningen/meters> a adms:Asset, foaf:Document;
  dct:created "2024-04-30T00:00:00"^^xsd:dateTime;
  dct:creator <https://data.vlaanderen.be/id/organisatie/OVO002949>;
  dct:description "Het vocabularium \"OSLO Digitale Watermeter\" definieert termen specifiek voor het beheer en de monitoring van waterverbruik via digitale watermeters. Het beschrijft kenmerkende eigenschappen van digital watermeters, waaronder de componenten zoals verbruiksobservatie, sensoren en meters. Deze termen zijn aangepast om nauwkeurig het (drink)waterverbruik te beschrijven. Dit vocabularium is afgestemd op OSLO modellen IMKL (Informatie Model Kabels en Leidingen), toegespitst op de specifieke eisen en functionaliteiten van digitale watermeters."@nl;
  dct:identifier "https://data.vlaanderen.be/ns/nutsvoorzieningen/meters";
  dct:issued "2025-02-06T00:00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/NLD>;
  dct:modified "2024-04-30T00:00:00"^^xsd:dateTime;
  dct:title "Vocabularium Nutsvoorzieningen Meters"@nl;
  dct:type <http://purl.org/vocommons/voaf#Vocabulary>;
  vann:preferredNamespaceUri "https://data.vlaanderen.be/ns/nutsvoorzieningen/"^^xsd:anyURI;
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://data.vlaanderen.be/id/organisatie/OVO002949>;
  dcat:distribution _:5e6c9eda986b294, _:genid-b04a3c316b9c487c8f8809c4236962a115131-8C671DEBA3FA6E2131DDCD2FA2E65D38;
