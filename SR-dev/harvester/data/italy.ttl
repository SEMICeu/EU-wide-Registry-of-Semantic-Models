  rdfs:label "Lactation Status"@en, "Stato della Lattazione"@it;
  rdfs:isDefinedBy <https://w3id.org/leo/data/distribution/LACT-JSON-LD>, <https://w3id.org/leo/data/distribution/LACT-RDF-TURTLE>,
    <https://w3id.org/leo/data/distribution/LACT-RDF-XML> .

<https://w3id.org/leo/onto/lactation-assessment/ParturitionOrder> a rdfs:Class;
  rdfs:label "Parturition Order"@en, "Ordine di Parto"@it;
  rdfs:isDefinedBy <https://w3id.org/leo/data/distribution/LACT-JSON-LD>, <https://w3id.org/leo/data/distribution/LACT-RDF-TURTLE>,
    <https://w3id.org/leo/data/distribution/LACT-RDF-XML> .

<https://w3id.org/leo/onto/lactation-assessment> a adms:Asset;
  m8g:isReusedBy "https://w3id.org/leo/data/project/LEO"^^xsd:anyURI;
  dct:creator <https://w3id.org/leo/data/private-organization/00944701002>, <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:description "This is the ontology used to model data on lactation controls carried out in the livestock environment. The data is collected in the context of the LEO project - Livestock Environment Open Data. In particular, the SIALL system, when acquiring Functional Testing data, at the time when parturition and late abortion events are detected, collects information on lactation for both dairy and beef animals. Among this information is also the parturition order through which primiparae and pluriparae are categorised on a zootechnical level.  For dairy animals, information on estimated actual production (milk, fat and protein) and estimated conventional milk, i.e. the milk produced at a standard lactation length, is tracked; if the calculation of actual and conventional production is abnormal compared to the AIA standard, the lactation has some note."@en,
    "Questa è l'ontologia usata per modellare i dati relativi ai controlli sulla lattazione svolti nell'ambito zootecnico. I dati sono raccolti nel contesto del progetto LEO - Livestock Environment Open Data. In particolare, il sistema SIALL a fronte dell’acquisizione di dati di Controllo funzionale, nel momento in cui vengono rilevati gli eventi parto e aborto tardivo, raccoglie informazioni sulla lattazione sia per i soggetti da latte che per i soggetti da carne. Tra queste informazioni vi è anche l'ordine di parto attraverso cui sono categorizzati a livello zootecnico le primipare e le pluripare.  Per i soggetti allevati da latte si tracciano informazioni inerenti alla stima della produzione effettiva (latte, grasso e proteine) e la stima del latte convenzionale cioè il latte prodotto ad una lunghezza standard di lattazione; se il calcolo della produzione effettiva e della convenzionale è anomalo rispetto allo standard AIA la lattazione presenta delle note"@it;
  dct:identifier "https://w3id.org/leo/onto/lactation-assessment";
  dct:issued "2023-03-17T00:00:00+00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/ENG>, <http://publications.europa.eu/resource/authority/language/ITA>;
  dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0>;
  dct:modified "2023-03-17T00:00:00+00:00"^^xsd:dateTime;
  dct:publisher <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:requires <https://w3id.org/leo/onto/livestock-assessment>;
  dct:title "Lactation Assessment Ontology"@en, "Ontologia della Lattazione"@it;
  vann:preferredNamespaceUri "https://w3id.org/leo/onto/lactation-assessment/"^^xsd:anyURI;
  owl:versionInfo "Version 0.1 - 2023 - Creation of the ontology";
  adms:status <http://purl.org/adms/status/UnderDevelopment>;
  dcat:contactPoint <https://w3id.org/leo/data/contact-point/onto-aia>;
  dcat:distribution <https://w3id.org/leo/data/distribution/LACT-JSON-LD>, <https://w3id.org/leo/data/distribution/LACT-RDF-TURTLE>,
    <https://w3id.org/leo/data/distribution/LACT-RDF-XML>;
  dcat:keyword "Ordine di parto"@it;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/AGRI> .

