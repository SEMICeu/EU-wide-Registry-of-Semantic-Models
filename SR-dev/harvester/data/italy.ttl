<https://w3id.org/italia/onto/CPSV> a adms:Asset;
  m8g:isReusedBy "https://w3id.org/italia/data/project/DAF"^^xsd:anyURI, "https://w3id.org/italia/data/project/ITAServiceCatalogue"^^xsd:anyURI,
    "https://w3id.org/italia/data/project/OntoPiA"^^xsd:anyURI;
  dct:creator <http://spcdata.digitpa.gov.it/browse/page/Amministrazione/agid>;
  dct:description "This is the ontology of the Italian application profile for public services. With the term \"public service\" we mean any discretional or mandatory act carried out by a Public Administration (or on behalf of a Public Administration) for the advantage of citizens and enterprises."@en,
    "Ontologia del profilo italiano per la descrizione dei servizi pubblici. Per servizio pubblico si intende qualsiasi atto obbligatorio o discrezionale espletato da una pubblica amministrazione (o per conto di una pubblica amministrazione) nei confronti di cittadini, imprese/professionisti."@it;
  dct:identifier "https://w3id.org/italia/onto/CPSV";
  dct:issued "2015-11-21T00:00:00+00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/ENG>, <http://publications.europa.eu/resource/authority/language/ITA>;
  dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0>;
  dct:modified "2020-09-30T00:00:00+00:00"^^xsd:dateTime;
  dct:publisher <http://spcdata.digitpa.gov.it/browse/page/Amministrazione/agid>;
  dct:requires <https://w3id.org/italia/onto/AccessCondition>, <https://w3id.org/italia/onto/CLV>,
    <https://w3id.org/italia/onto/COV>, <https://w3id.org/italia/onto/Language>, <https://w3id.org/italia/onto/MU>,
    <https://w3id.org/italia/onto/RO>, <https://w3id.org/italia/onto/SM>, <https://w3id.org/italia/onto/TI>,
    <https://w3id.org/italia/onto/l0>;
  dct:title "Core Public Service Vocabulary - The Italian Application Profile (CPSV-AP_IT)"@en,
    "Ontologia dei Servizi Pubblici - Core Public Service Vocabulary - Profilo applicativo italiano (CPSV-AP_IT)"@it;
  vann:preferredNamespaceUri "https://w3id.org/italia/onto/CPSV/"^^xsd:anyURI;
  owl:versionInfo "Version 1.1 - Modified on 30 September 2020 - Use of the definition of Public Service defined in the European application profile CPSV-AP. This emerged from users requests expressed in the following issue: https://github.com/italia/dati-semantic-assets/issues/92";
  adms:status <http://purl.org/adms/status/UnderDevelopment>;
  dcat:contactPoint <https://w3id.org/italia/data/contact-point/onto-agid>;
  dcat:distribution <https://w3id.org/italia/data/distribution/CPSVAPIT-JSON-LD>, <https://w3id.org/italia/data/distribution/CPSVAPIT-RDF-TURTLE>,
    <https://w3id.org/italia/data/distribution/CPSVAPIT-RDF-XML>;
  dcat:keyword "Servizio pubblico"@it;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/GOVE> .

