  dct:modified "2023-03-09T00:00:00+00:00"^^xsd:dateTime;
  dct:publisher <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:requires <https://w3id.org/leo/onto/livestock-assessment>;
  dct:title "Health Assessment Ontology - HeathData"@en, "Ontologia degli Accertamenti Sanitari (inclusi Screening Aziendali)- HealthData"@it;
  vann:preferredNamespaceUri "https://w3id.org/leo/onto/health-assessment/"^^xsd:anyURI;
  owl:versionInfo "Version 0.2 - 2023 - Revision of the ontology based on the availability of livestock assessment general ontology";
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://w3id.org/leo/data/contact-point/onto-aia>;
  dcat:distribution <https://w3id.org/leo/data/distribution/HA-JSON-LD>, <https://w3id.org/leo/data/distribution/HA-RDF-TURTLE>,
    <https://w3id.org/leo/data/distribution/HA-RDF-XML>;
