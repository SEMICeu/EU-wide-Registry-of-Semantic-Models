<https://data.vlaanderen.be/ns/netwerk> a adms:Asset, foaf:Document;
  dct:created "2020-04-23T00:00:00"^^xsd:dateTime;
  dct:creator <https://data.vlaanderen.be/id/organisatie/OVO000096>;
  dct:description "Het vocabularium \"OSLO-Netwerk\" definieert termen die van toepassing zijn op netwerken in het algemeen. Het beschrijft basiskenmerken van een netwerk zoals de elementen waaruit het bestaat bv knopen, linken, zones, connecties. De termen zijn bedoeld om gespecialiseerd te worden voor het beschrijven van netwerken met specifieke functies, bv transportnetwerken of hydrografische netwerken. Dit vocabularium is gebaseerd op hetGeneric Network Modelvan INSPIRE."@nl;
  dct:identifier "https://data.vlaanderen.be/ns/netwerk";
  dct:issued "2020-04-23T00:00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/NLD>;
