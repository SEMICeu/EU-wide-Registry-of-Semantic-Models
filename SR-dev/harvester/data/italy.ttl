<https://w3id.org/leo/onto/livestockfarm-building-description> a adms:Asset;
  m8g:isReusedBy "https://w3id.org/leo/data/project/LEO"^^xsd:anyURI;
  dct:creator <https://w3id.org/leo/data/private-organization/00944701002>, <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:description "This is the ontology that allows one to describe a series of characteristics of the buildings of Italian livestock farms. In particular, the ontology allows one to model all the data related to a questionnaire that the farms fill in in the Si@llEvA system concerning the physical characteristics of the buildings. In the context of the livestock domain, these data is referred to as the so-called 'building configurator'."@en,
    "Questa è l'ontologia che consente di descrivere una serie di caratteristiche degli edifici (o insediamenti) delle aziende di allevamento italiane. In particolare, l'ontologia consente di modellare tutti i dati relativi a un questionario che le aziende compilano nel sistema si@llEvA relativamente alle caratteristiche fisiche degli insediamenti. Nel contesto del dominio zootecnico questi dati si riferiscono al cosiddetto 'Configuratore insediamento'"@it;
  dct:identifier "https://w3id.org/leo/onto/livestockfarm-building-description";
  dct:issued "2022-04-15T00:00:00+00:00"^^xsd:dateTime;
  dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0>;
  dct:modified "2023-06-22T00:00:00+00:00"^^xsd:dateTime;
  dct:publisher <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:requires <https://w3id.org/italia/onto/l0>;
  dct:title "Livestock Farm Building Description Ontology"@en, "Ontologia della descrizione dell'insediamento (edificio) dell'azienda d'allevamento"@it;
  vann:preferredNamespaceUri "https://w3id.org/leo/onto/livestockfarm-building-description/"^^xsd:anyURI;
  owl:versionInfo "Version 0.2 - introduction of OWL restrictions.";
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://w3id.org/leo/data/contact-point/onto-aia>;
  dcat:distribution <https://w3id.org/leo/data/distribution/LFBD-JSON-LD>, <https://w3id.org/leo/data/distribution/LFBD-RDF-TURTLE>,
    <https://w3id.org/leo/data/distribution/LFBD-RDF-XML>;
  dcat:keyword "Tipologia Edificio"@it;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/AGRI> .

