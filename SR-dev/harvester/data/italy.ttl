<https://w3id.org/leo/onto/weather> a adms:Asset;
  m8g:isReusedBy "https://w3id.org/leo/data/project/LEO"^^xsd:anyURI;
  dct:creator <https://w3id.org/leo/data/private-organization/00944701002>, <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:description "This is the ontology for modelling the data known as ClimData in the LEO project, i.e. climate data collected as observations captured by weather stations. The ontology also includes the concepts for representing the installation of weather stations within livestock companies' settlements."@en,
    "Questa è l'ontologia per modellare i dati detti ClimData nel progetto LEO ovvero i dati raccolti di tipo climatico, intesi come osservazioni catturate da stazioni meteo. L'ontologia include anche i concetti che consentono di rappresentare l'installazione delle centraline meteo all'interno di insediamenti dell'allevamento."@it;
  dct:identifier "https://w3id.org/leo/onto/weather";
  dct:issued "2019-11-20T00:00:00+00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/ENG>, <http://publications.europa.eu/resource/authority/language/ITA>;
  dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0>;
  dct:modified "2023-06-22T00:00:00+00:00"^^xsd:dateTime;
