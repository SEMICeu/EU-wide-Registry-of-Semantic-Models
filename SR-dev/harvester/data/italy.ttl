<https://w3id.org/italia/onto/COV> a adms:Asset;
  m8g:isReusedBy "https://w3id.org/italia/data/project/DAF"^^xsd:anyURI, "https://w3id.org/italia/data/project/OntoPiA"^^xsd:anyURI;
  dct:creator <http://spcdata.digitpa.gov.it/Amministrazione/agid>, <https://w3id.org/italia/data/organization/support-unit/cnr-Z6HZEH/stlab>;
  dct:description "This is the ontology of the Italian application profile for Organizations (Public and Private). It allows one to model the main information on organizations (public or private), including the organization of the offices and their head of units. "@en,
    "Questa è l'ontologia del profilo applicativo italiano sulle organizzazioni (pubbliche e private). Essa consente di modellare le principali informazioni sull'anagrafica delle organizzazioni pubbliche e private (inclusa l'articolazione degli uffici e dei relativi responsabili)."@it;
  dct:identifier "https://w3id.org/italia/onto/COV";
  dct:issued "2017-07-20T00:00:00+00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/ENG>, <http://publications.europa.eu/resource/authority/language/ITA>;
  dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0>;
  dct:modified "2020-09-30T00:00:00+00:00"^^xsd:dateTime;
  dct:publisher <http://spcdata.digitpa.gov.it/Amministrazione/agid>;
  dct:requires <https://w3id.org/italia/onto/CLV>, <https://w3id.org/italia/onto/MU>,
    <https://w3id.org/italia/onto/RO>, <https://w3id.org/italia/onto/SM>, <https://w3id.org/italia/onto/TI>,
    <https://w3id.org/italia/onto/l0>;
  dct:title "Organization (public and private) ontology - Italian application profile"@en,
    "Ontologia delle Organizzazioni (pubbliche e private)- Profilo applicativo italiano"@it;
  vann:preferredNamespaceUri "https://w3id.org/italia/onto/COV/"^^xsd:anyURI;
  owl:versionInfo "Version 0.12 - Modified 30 September 2020 - Fixed some typos and introduced the object property hasAlternativeIdentifier that can be associated with the Organization. Currently the property exploits the Identifier class (with its properties) defined in the context of the Core Location Vocabulary (CLV) - Italian Application Profile, which is imported in this ontology. However, a better modelling would suggest to create an ontological module for Identifiers that is exteranal to the CLV and that can be then re-used by this ontology, the CLV ontology and potentially other ontologies of the OntoPiA network.";
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://w3id.org/italia/data/contact-point/onto-agid>;
  dcat:distribution <https://w3id.org/italia/data/distribution/COV-JSON-LD>, <https://w3id.org/italia/data/distribution/COV-RDF-TURTLE>,
