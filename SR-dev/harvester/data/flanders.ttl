  dcat:contactPoint <https://data.vlaanderen.be/id/organisatie/OVO002949>;
  dcat:distribution _:5e6c9eda986b39d, _:5e6c9eda986b39a;
  foaf:homepage <https://data.vlaanderen.be/doc/applicatieprofiel/DigitaleWatermeter> .

