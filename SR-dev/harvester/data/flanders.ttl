<https://data.vlaanderen.be/ns/sensoren-en-bemonstering/> a adms:Asset, foaf:Document;
  dct:created "2024-09-05T00:00:00"^^xsd:dateTime;
  dct:creator <https://data.vlaanderen.be/id/organisatie/OVO027735>;
  dct:description """Het vocabularium Sensoren en Bemonstering bevat de terminologie nodig om de waarnemingsinstrumenten waarmee Observaties worden uitgevoerd te beschrijven en ook om de activiteit van het nemen van representatieve ruimtelijke of fysieke stalen te documenteren.
Het grootste deel is externe terminologie gebaseerd op deW3C SSN Ontologieenextensies.Deze bouwen verder op terminologie uitISO 19156:2011 Observations & Measurements. Verder werd een klasse herbruikt uit deSAREF Ontologyom Toestellen te beschrijven."""@nl;
  dct:identifier "https://data.vlaanderen.be/ns/sensoren-en-bemonstering/";
  dct:language <http://publications.europa.eu/resource/authority/language/NLD>;
  dct:modified "2024-09-05T00:00:00"^^xsd:dateTime;
  dct:title "Vocabularium Sensoren en Bemonstering"@nl;
  dct:type <http://purl.org/vocommons/voaf#Vocabulary>;
  vann:preferredNamespaceUri "https://data.vlaanderen.be/ns/sensoren-en-bemonstering/"^^xsd:anyURI;
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://data.vlaanderen.be/id/organisatie/OVO027735>;
  dcat:distribution _:5e6c9eda986b270, _:5e6c9eda986b26f;
