<https://w3id.org/italia/onto/CPV> a adms:Asset;
  m8g:isReusedBy "https://w3id.org/italia/data/project/NDC"^^xsd:anyURI, "https://w3id.org/italia/data/project/OntoPiA"^^xsd:anyURI;
  dct:creator <https://w3id.org/italia/data/public-organization/ISTAT>, <https://w3id.org/italia/data/public-organization/agid>;
  dct:description "This is the ontology of the Italian application profile on persons. The ontology models general information on natural persons such as first name, surname, date of birth, place of birth, tax code, residence, citizenship and relations between persons both generic of knowledge and generic of kinship relations but not as registered with the civil registry."@en,
    "Questa è l'ontologia del profilo applicativo italiano sulle persone. L'ontologia modella informazioni generali sulle persone fisiche come per esempio il nome, cognome, data di nascita, luogo di nascita, codice fiscale, residenza, cittadinanza e relazioni tra persone sia generiche di conoscenza sia di generiche relazioni di parentela ma non come registrate presso l'anagrafe."@it;
  dct:identifier "https://w3id.org/italia/onto/CPV";
  dct:issued "2017-07-19T00:00:00+00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/ENG>, <http://publications.europa.eu/resource/authority/language/ITA>;
  dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0>;
  dct:modified "2023-03-15T00:00:00+00:00"^^xsd:dateTime;
  dct:publisher <https://w3id.org/italia/data/public-organization/PCM-1RSIZZ>;
  dct:requires <https://w3id.org/italia/onto/CLV>, <https://w3id.org/italia/onto/TI>,
    <https://w3id.org/italia/onto/l0>;
  dct:title "CPV-AP_IT - Core Person Vocabulary Italian Application Profile - Person Ontology"@en,
    "CPV-AP_IT: Core Person Vocabulary - profilo applicativo italiano - Ontologia delle persone"@it;
  vann:preferredNamespaceUri "https://w3id.org/italia/onto/CPV/"^^xsd:anyURI;
  owl:versionInfo "Version 0.8 - updated on 15th of March 2023 - Deleted Registered Family and everything related to civil registration information of persons (e.g., parental relationship as store in the national civil registry, family sheet holder). Deleted BornDead class and introduced the Gender concept to be distinguished from the Sex Concept. Simplified the residence modelling leaving in the ontology only two main elaments: a general residentIn property for a Person and the ResidenceInTime reification to model this type of general information on the residence of a person that may change over time. Changed the domain of the property hasLevelOfEducation to be used for every type of person and changed the metadata of the ontology.";
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://w3id.org/italia/data/contact-point/ISTAT-NDC>;
  dcat:distribution <https://w3id.org/italia/data/distribution/CPVAPIT-JSON-LD>, <https://w3id.org/italia/data/distribution/CPVAPIT-RDF-TURTLE>,
    <https://w3id.org/italia/data/distribution/CPVAPIT-RDF-XML>;
  dcat:keyword "persone"@it;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/SOCI> .

