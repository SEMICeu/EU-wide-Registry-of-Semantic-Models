<https://data.vlaanderen.be/ns/slimmeraadpleegomgeving> a adms:Asset, foaf:Document;
  dct:created "2024-02-08T00:00:00"^^xsd:dateTime;
  dct:creator <https://data.vlaanderen.be/id/organisatie/OVO001835>;
  dct:description """Dit vocabularium voegt zaken toe aan bestaande standaarden rond Besluiten om besluiten van het lokaal bestuur te verrijken met gestandaardiseerde data op vlak van beleidsthema’s, adres/locatie, gecoördineerde versie’s, Lokale Producten- en DienstenCataloog (LPDC), initiatiefrecht en voorwaardelijk recht. Op basis van deze gestandaardiseerde data kunnen raadpleegomgevingen beter uitgewerkt worden op maat van de burger. 
Deze standaard kwam tot stand door het Gemeente zonder Gemeente-trajectSlimme raadpleegomgeving in de broekzak van de burger."""@nl;
  dct:identifier "https://data.vlaanderen.be/ns/slimmeraadpleegomgeving";
  dct:issued "2024-12-05T00:00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/NLD>;
  dct:modified "2024-02-08T00:00:00"^^xsd:dateTime;
  dct:title "Vocabularium Slimme Raadpleegomgeving"@nl;
  dct:type <http://purl.org/vocommons/voaf#Vocabulary>;
  vann:preferredNamespaceUri "https://data.vlaanderen.be/ns/"^^xsd:anyURI;
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://data.vlaanderen.be/id/organisatie/OVO001835>;
  dcat:distribution _:5e6c9eda986b271, _:genid-b04a3c316b9c487c8f8809c4236962a115218-E83D6ED9494A7ABFD27D2223BC20BE72;
  foaf:homepage <https://data.vlaanderen.be/ns/slimmeraadpleegomgeving> .

