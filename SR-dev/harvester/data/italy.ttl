<https://w3id.org/leo/onto/ale/AnimalLifeEvent> a rdfs:Class;
  rdfs:label "Animal Life Event"@en, "Evento della Vita Animale di Allevamento"@it;
  rdfs:isDefinedBy <https://w3id.org/leo/data/distribution/ALE-JSON-LD>, <https://w3id.org/leo/data/distribution/ALE-RDF-TURTLE>,
    <https://w3id.org/leo/data/distribution/ALE-RDF-XML> .

<https://w3id.org/leo/onto/ale> a adms:Asset;
  m8g:isReusedBy "https://w3id.org/leo/data/project/LEO"^^xsd:anyURI;
  dct:creator <https://w3id.org/leo/data/private-organization/00944701002>, <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:description "The ontology thus represents important moments in the life of animals, such as birth, abortion, fertilisation, the various movements on and off farms, slaughter, etc. For each event, the ontology represents the main elements that characterise it."@en,
    "Questa è l'ontologia degli eventi della vita degli animali di allevamento, L'ontologia rappresenta pertanto momenti importanti della vita degli animali come per esempio il parto, la nascita, l'aborto, la fecondazione, i vari spostamenti in entrata e uscita dalle aziende di allevamento, il macello, ecc. Per ogni evento, l'ontologia rappresenta elementi principali che caratterizzano ciascun evento."@it;
  dct:identifier "https://w3id.org/leo/onto/ale";
  dct:issued "2018-06-18T00:00:00+00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/ENG>, <http://publications.europa.eu/resource/authority/language/ITA>;
  dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0>;
  dct:modified "2023-06-20T00:00:00+00:00"^^xsd:dateTime;
  dct:publisher <https://w3id.org/leo/data/private-organization/06695411006>;
  dct:requires <https://w3id.org/italia/onto/TI>, <https://w3id.org/italia/onto/l0>;
  dct:title "Animal Life Event Ontology"@en, "Ontologia degli eventi della vita degli animali di allevamento"@it;
  vann:preferredNamespaceUri "https://w3id.org/leo/onto/ale/"^^xsd:anyURI;
  owl:versionInfo "Version 1.0- June 2023 - Introduction of new animal life events, i.e., weaning, weighing, breast feeding termination, back fat thickness measurement, and related parameters.";
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://w3id.org/leo/data/contact-point/onto-aia>;
