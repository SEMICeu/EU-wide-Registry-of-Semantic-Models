<https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod> a adms:Asset, foaf:Document;
  dct:created "2020-04-23T00:00:00"^^xsd:dateTime;
  dct:creator <https://data.vlaanderen.be/id/organisatie/OVO000096>;
  dct:description """Het vocabularium \"OSLO-Mobiliteit: Trips en Aanbod\" definieert termen die van toepassing zijn op (1) door personen uitgevoerde reizen en (2) de mobiliteitsdiensten die ze daarvoor ter beschikking hebben.
Van de reizen worden zaken gedefinieerd als de gevolgde route, de gebruikte diensten/resources/infrastructuur, de uitvoerder, de aangekochte tickets, reizigersvoorkeuren en -kenmerken.
Bij de mobiliteitsdiensten gaat het over begrippen als de door de reiziger te reserveren resources, de infrastructuur waarover de dienst beschikt, gegevens over de aanbieder en de uitvoerder, de licenties waarover deze beschikken."""@nl;
  dct:identifier "https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod";
  dct:issued "2020-04-23T00:00:00"^^xsd:dateTime;
  dct:language <http://publications.europa.eu/resource/authority/language/NLD>;
  dct:modified "2020-04-23T00:00:00"^^xsd:dateTime;
  dct:title "Vocabularium Mobiliteit Trips en Aanbod"@nl;
  dct:type <http://purl.org/vocommons/voaf#Vocabulary>;
  vann:preferredNamespaceUri "https://data.vlaanderen.be/ns/mobiliteit/"^^xsd:anyURI;
  adms:status <http://purl.org/adms/status/Completed>;
  dcat:contactPoint <https://data.vlaanderen.be/id/organisatie/OVO000096>;
