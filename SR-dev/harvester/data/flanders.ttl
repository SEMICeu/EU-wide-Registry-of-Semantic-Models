<https://data.vlaanderen.be/doc/applicatieprofiel/loongegevens> a adms:Asset, foaf:Document;
  dct:created "2021-09-16T00:00:00"^^xsd:dateTime;
  dct:creator <https://data.vlaanderen.be/id/organisatie/OVO008643>;
  dct:description "Dit applicatieprofiel werd ontwikkeld om binnen het domein \"inkomen\" de verschillende datastromen met betrekking tot dit domein semantisch te modelleren en de structuur van de data te standaardiseren. Voor veel dienstverleningen is het belangrijk dat er kan ingespeeld worden op de actuele inkomenssituatie van een persoon. O.a. volgende elementen met betrekking tot looninformatie worden gecapteerd in dit applicatieprofiel: metadata zoals informatie over de werkgever en gegevens van de loonfiche, het bruto belastbaar inkomen, details over het nettoloon zoals maaltijdcheques, bedrijfsvoorheffing, premies, ... Het applicatieprofiel is generiek opgesteld maar is toch in staat om de nodige mate van detail aan te leveren. Enkel de data die strikt noodzakelijk is, wordt gedeeld. Dit applicatieprofiel voor loongegevens kan dienen als documentatie voor analisten en ontwikkelaars."@nl;
  dct:identifier "https://data.vlaanderen.be/doc/applicatieprofiel/loongegevens";
  dct:language <http://publications.europa.eu/resource/authority/language/NLD>;
  dct:modified "2021-09-16T00:00:00"^^xsd:dateTime;
  dct:title "Applicatieprofiel loongegevens"@nl;
  dct:type prof:Profile;
  vann:preferredNamespaceUri "https://data.vlaanderen.be/doc/applicatieprofiel/loongegevens"^^xsd:anyURI;
