ns33:leerprestatiecredential	dcterms:description	"\u03A3\u03C5\u03BC\u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03C4\u03B5 \u03BC\u03B9\u03B1 \u03C0\u03B5\u03C1\u03AF\u03BB\u03B7\u03C8\u03B7 \u03C4\u03BF\u03C5 \u03C0\u03C1\u03BF\u03C6\u03AF\u03BB \u03C4\u03B7\u03C2 \u03B1\u03AF\u03C4\u03B7\u03C3\u03AE\u03C2 \u03BC\u03BF\u03C5 \u03B5\u03B4\u03CE."@el-t-en-t0-mtec .
